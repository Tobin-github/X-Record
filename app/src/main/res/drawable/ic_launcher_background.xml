<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层。

  108×108 的视口是自适应图标的规范尺寸，系统会按各厂商的形状（圆形、方形、
  水滴等）裁切掉外侧约 18dp，所以背景必须铺满整个视口。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF1FB574" />
                <item android:offset="1" android:color="#FF0A6E44" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
